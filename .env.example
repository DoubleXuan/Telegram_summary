# Create these at https://my.telegram.org/apps
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace_me
TELEGRAM_PHONE=+8613800000000

# Create the bot with @BotFather, then send /start to it from your own account.
TELEGRAM_BOT_TOKEN=123456:replace_me
TELEGRAM_OWNER_ID=123456789

# Choose exactly one authentication method.
# Standard Anthropic Platform:
ANTHROPIC_API_KEY=sk-ant-replace_me

# Local Anthropic-compatible gateway (comment ANTHROPIC_API_KEY above when using this):
# ANTHROPIC_AUTH_TOKEN=replace_me
# ANTHROPIC_BASE_URL=http://localhost:8317
# ANTHROPIC_MODEL=gpt-5.5
# ANTHROPIC_COMPATIBILITY_MODE=true

# Optional. Model-output repair and failed-run limits are configured under summary in YAML.
TG_DIGEST_CONFIG=config/groups.yaml
TG_DIGEST_DATA_DIR=data
TG_DIGEST_LOG_LEVEL=INFO
# TG_DIGEST_LOG_FILE=data/tg-digest.log
TG_DIGEST_LOG_MAX_BYTES=10485760
TG_DIGEST_LOG_BACKUP_COUNT=5
TG_DIGEST_LOG_CONSOLE=true
